@model RPS.Web.Models.ViewModels.PtDashboardVm
@using RPS.Web.Models.ViewModels;

@section styles {
    @Styles.Render("~/Content/dashboardcss")
    @Styles.Render("~/Content/activeissuescss")
}


<div class="dashboard-page page">

    <div class="container">
        <div class="row align-items-center justify-content-between">
            <div class="col-auto">
                <div class="frame13 d-flex flex-column align-items-start gap-2">
                    <div class="page-title">Dashboard</div>
                </div>
            </div>

            <div class="col-auto">
                <div class="Tools d-flex gap-3">
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <div class="btn-group me-2">


                        </div>
                        <div class="btn-group mr-2">
                            <button type="button" class="btn btn-light" data-range="3" onclick="location.href = '@(Url.Action("Index", "Dashboard", new { months = 3, userId = ViewBag.userId }))'">
                                3 Months
                            </button>
                            <button type="button" class="btn btn-light" data-range="6" onclick="location.href = '@(Url.Action("Index", "Dashboard", new { months = 6, userId = ViewBag.userId  }))'">
                                6 Months
                            </button>
                            <button type="button" class="btn btn-light" data-range="12" onclick="location.href = '@(Url.Action("Index", "Dashboard", new { months = 12, userId = ViewBag.userId  }))'">
                                1 Year
                            </button>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="container">
        <div class="DiagramAndStatistics">
            <div class="StatisticsBlock">
                @Html.Partial("_ActiveIssues", new PtActiveIssuesVm(Model.StatusCounts))
            </div>


            <div class="frame36 stretch-height">
                <div class="frame38">
                    <div class="Statistics left-stat-block">
                        <div class="Label inline-flex">
                            <div class="BaseInputLabel gap-6">
                                <div class="statistics-heading">All Issues</div>
                            </div>
                        </div>
                        <div class="Label inline-flex">
                            <div class="BaseInputLabel gap-6">
                                <div class="statistics-subheading">Active Issues</div>
                            </div>
                        </div>
                    </div>

                    <div class="Statistics right-stat-block">
                        <div class="Label inline-flex">
                            <div class="BaseInputLabel gap-6">
                                <div class="statistics-subheading">
                                    Highest: 100% on Oct 11, 2018
                                </div>
                            </div>
                        </div>
                        <div class="Label inline-flex">
                            <div class="BaseInputLabel gap-6">
                                <div class="statistics-subheading">
                                    Lowest: 20% on Oct 9, 2018
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="frame36 chart-section">
                @Html.Partial("_DashboardChart", new PtDashboardChartVm(Model.FilteredIssues))
                @*{filteredIssues && <DashboardChart issuesAll={filteredIssues} />}*@
            </div>
        </div>
    </div>
</div>


